layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -270.0
offset_top = -250.0
offset_right = 270.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="ControlsPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "CONTROLES"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2

[node name="MoveLabel" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Moverte:  W A S D  o  flechas"

[node name="CameraLabel" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Cámara:  Ratón  o  stick derecho"

[node name="JumpLabel" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Saltar:  Espacio  (mantén para saltar más alto)"

[node name="PauseLabel" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Pausa:  Escape  o  Start del mando"

[node name="RestartLabel" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Reiniciar carrera:  R"

[node name="GoalLabel" type="Label" parent="ControlsPanel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.65)
theme_override_font_sizes/font_size = 14
text = "Objetivo: cruza el circuito y persigue la medalla de oro."
autowrap_mode = 2

[node name="BackButton" type="Button" parent="ControlsPanel/VBoxContainer"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_type_variation = &"GhostButton"
text = "VOLVER"

[node name="CreditsPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -270.0
offset_top = -190.0
offset_right = 270.0
offset_bottom = 190.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CreditsPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="CreditsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "CRÉDITOS"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="CreditsPanel/VBoxContainer"]
layout_mode = 2

[node name="ProjectLabel" type="Label" parent="CreditsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Tumble Rush"

[node name="AuthorLabel" type="Label" parent="CreditsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Autores: Pol Arjona y Yazan Issa"

[node name="EngineLabel" type="Label" parent="CreditsPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Motor: Godot Engine 4.7"

[node name="AILabel" type="Label" parent="CreditsPanel/VBoxContainer"]
layout_mode = 2
